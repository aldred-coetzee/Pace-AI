# pace-ai configuration. This file is a TEMPLATE: the real one lives outside
# the checkout (the repo is public). Copy it to
#   ~/.local/share/pace-ai/config.env     (or $PACE_AI_WORKSPACE/config.env)
# and lock it down:  chmod 600 ~/.local/share/pace-ai/config.env
# Real environment variables override anything set here.
# Every personal file (databases, Garmin/Withings tokens) lives in that same
# directory; relative paths below resolve against it.
# PACE_AI_WORKSPACE=~/.local/share/pace-ai   # env only: where the workspace is

# ── Strava API Credentials ──────────────────────────────────────────
# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to "localhost"
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# ── Strava OAuth Tokens (optional) ──────────────────────────────────
# Leave blank, or paste tokens from the Strava API settings page for bootstrap.
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
# STRAVA_DB=strava.db          # SQLite database path (tokens + cache)

# ── Garmin Connect Credentials ──────────────────────────────────────
# Needed ONLY by the pace-ai-garmin-login CLI; delete them from the file once
# logged in. The app itself runs from the saved garth tokens.
# After first login, garth saves session tokens to GARTH_HOME.
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password
# GARTH_HOME=garth             # Where garth stores session tokens

# ── Withings (optional) ─────────────────────────────────────────────
# User tokens (.withings_user.json) live in <workspace>/withings; a
# withings_app.json placed there overrides the library-bundled app config.
# WITHINGS_CONFIG_FOLDER=withings

# ── Notion running diary ────────────────────────────────────────────
# Internal integration secret (ntn_...) and the diary database ID
NOTION_TOKEN=
NOTION_DIARY_DATABASE_ID=
# NOTION_DB=notion.db          # SQLite cache path

# ── Coaching database (optional) ────────────────────────────────────
# PACE_AI_DB=pace_ai.db         # SQLite database path (history)
